# Which AI provider to use: openai | gemini | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional model overrides (defaults: gpt-4.1 / gemini-2.5-flash / deepseek)
# TUTOR_MODEL=gpt-4.1
# JUDGE_MODEL=gpt-4.1-mini
# Picks the textbook lesson once per chat (stronger model, small cost)
# ROUTER_MODEL=gpt-5.5

# First admin account, created on first start (change the password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Let students create their own accounts on the login page
ALLOW_SIGNUP=true
